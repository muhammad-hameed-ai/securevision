<?xml version="1.0" encoding="utf-8"?>
<!--
  Enrolled person profiles hold face embeddings and enrolment photos, and the
  product guarantees they never leave the device. Both cloud backup and
  device-to-device transfer are therefore excluded outright rather than
  selectively: an exclusion list that has to be kept in step with new storage
  locations is one forgotten entry away from leaking biometric data.

  Cloud backup is additionally disabled by android:allowBackup="false".
-->
<data-extraction-rules>

    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>

    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>

</data-extraction-rules>
