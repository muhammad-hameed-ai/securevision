<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Declared now, used later.
      INTERNET  — Firebase Auth and Firestore for the app-login account (Phase 3).
                  No other data is permitted to use it: all AI/ML is on-device.
      CAMERA    — the live detection screen (Phase 4).
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="true" />

    <application
        android:name=".SecureVisionApp"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SecureVision"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:allowBackup="false">

        <!--
          allowBackup is false deliberately. Enrolled person profiles hold face
          embeddings and enrolment photos, and the product guarantees those never
          leave the device. Cloud backup would break that guarantee silently.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SecureVision"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
